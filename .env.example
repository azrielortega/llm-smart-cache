# OpenRouter API key for real LLM calls (main.py, cli.py, benchmark.py).
# Not needed with --mock.
OPENROUTER_KEY=

# Optional overrides: all have working defaults, uncomment to change.

# Embedding model. Changing it needs a fresh cache (delete cache_data/).
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Must match the embedding model's output size.
# EMBEDDING_DIMENSION=384

# Cache hit threshold (squared L2). Lower = stricter.
# Re-tune with eval/tune_threshold.py if you change the embedding model.
# CACHE_MAX_DISTANCE=0.56

# OpenRouter model used on a cache miss.
# LLM_MODEL_NAME=openai/gpt-4o-mini

# DEBUG, INFO, WARNING or ERROR.
# LOG_LEVEL=INFO

# USD per 1K tokens, used by benchmark.py for $ saved. Defaults are gpt-4o-mini.
# LLM_PROMPT_COST_PER_1K=0.00015
# LLM_COMPLETION_COST_PER_1K=0.0006
