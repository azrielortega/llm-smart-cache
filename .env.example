# OpenRouter API key used by main.py
OPENROUTER_KEY=

# Optional overrides: all have working defaults, uncomment to change.
# Sentence-transformers model used to embed cached questions.
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Must match the output dimension of EMBEDDING_MODEL_NAME.
# EMBEDDING_DIMENSION=384

# Max (squared) L2 distance for a cache hit. Lower = stricter matching.
# Depends on EMBEDDING_MODEL_NAME - re-tune with eval/tune_threshold.py if you
# change the model. 0.56 was picked for all-MiniLM-L6-v2 (best F1 against a
# Quora Question Pairs eval set: 86.5% recall, 72.4% precision).
# CACHE_MAX_DISTANCE=0.56

# OpenRouter model id used for the actual LLM call on a cache miss.
# LLM_MODEL_NAME=openai/gpt-4o-mini

# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
# LOG_LEVEL=INFO

# USD cost per 1K tokens for LLM_MODEL_NAME, used by benchmark.py to estimate
# $ saved by the cache. Defaults match OpenRouter's openai/gpt-4o-mini pricing -
# override if you change LLM_MODEL_NAME.
# LLM_PROMPT_COST_PER_1K=0.00015
# LLM_COMPLETION_COST_PER_1K=0.0006
